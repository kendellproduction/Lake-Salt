rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the requester a provisioned admin? ──
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Public-lead field guards (defense-in-depth on top of render-side
    //    HTML-escaping). Non-strings pass untouched — numbers (tableCount,
    //    subtotal), booleans (includeBar), timestamps (createdAt), arrays
    //    (drinkSelections), and nested maps (quoteData) are never string-checked,
    //    so evolving payload shapes never get rejected. Fields are read via
    //    .get(k,'') so absent keys don't error. Only listed fields are
    //    constrained; anything else is allowed, so new form fields keep working.
    //    - leadStrOk : structured fields that never legitimately contain angle
    //                  brackets (name, email, venue…) — cap length AND reject <>.
    //    - leadTextOk: free-text (message, notes) — cap length only; the render
    //                  layer escapes them, and customers may type anything. ──
    function leadStrOk(v, maxLen) {
      return !(v is string) || (v.size() <= maxLen && v.matches('[^<>]*'));
    }
    function leadTextOk(v, maxLen) {
      return !(v is string) || v.size() <= maxLen;
    }
    function leadFieldsSafe(d) {
      return leadStrOk(d.get('name', ''),        200) &&
             leadStrOk(d.get('email', ''),       320) &&
             leadStrOk(d.get('phone', ''),        60) &&
             leadStrOk(d.get('eventType', ''),   120) &&
             leadStrOk(d.get('eventDate', ''),    80) &&
             leadStrOk(d.get('guestCount', ''),   60) &&
             leadStrOk(d.get('venue', ''),       300) &&
             leadStrOk(d.get('location', ''),    300) &&
             leadStrOk(d.get('source', ''),      120) &&
             leadStrOk(d.get('budget', ''),      120) &&
             leadStrOk(d.get('rentalType', ''),  120) &&
             leadTextOk(d.get('message', ''),        8000) &&
             leadTextOk(d.get('notes', ''),          8000) &&
             leadTextOk(d.get('drinkDetail', ''),    4000) &&
             leadTextOk(d.get('drinkSummary', ''),   4000) &&
             leadTextOk(d.get('quoteSummary', ''),   8000) &&
             leadTextOk(d.get('drinks', ''),         1000) &&
             leadTextOk(d.get('mockupName', ''),      300) &&
             leadTextOk(d.get('vision', ''),         4000);
    }

    // ── leads — public create (website form + /expo raffle), admin everything else ──
    match /leads/{id} {
      allow create: if leadFieldsSafe(request.resource.data);
      allow read, update, delete: if isAdmin();

      // Communications Hub — message threads mirrored from Gmail.
      // Written by syncGmail via the admin SDK (bypasses rules); the admin
      // dashboard reads them live. Admin-only, no public access. The /** glob
      // covers both threads/{threadId} and its messages/{messageId} subdocs.
      match /threads/{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // ── Agent Chat — Kendell ↔ agents thread + queued agent work ──
    // Messages are written by the agentChat function (admin SDK); the
    // dashboard reads them live and may read/adjust queued tasks.
    match /agent_chat/{document=**} { allow read, write: if isAdmin(); }
    match /agent_tasks/{id}         { allow read, write: if isAdmin(); }
    match /agent_brief/{id}         { allow read, write: if isAdmin(); }

    // ── Communications Hub: unmatched messages (no confident lead match) ──
    // Created by syncGmail (admin SDK); admins read + attach them to a lead.
    match /unmatched_messages/{id} { allow read, write: if isAdmin(); }

    // ── Communications Hub: raw Zapier inbound queue (fallback auth path) ──
    // The Zap writes here when OAuth isn't configured; syncGmail drains it.
    match /gmail_inbound_raw/{id} { allow read, write: if isAdmin(); }

    // ── admins — own-doc access for first-login + role checks ──
    match /admins/{id} {
      allow read:  if request.auth != null &&
                      (request.auth.uid == id || isAdmin());
      allow write: if isAdmin() ||
                      (request.auth != null &&
                       request.auth.uid == id &&
                       request.auth.token.email in ['kendellproduction@gmail.com',
                                                    'maddiejeanandrews@gmail.com']);
    }

    // ── Per-user preferences (dashboard widget layout, theme) ──
    // Each signed-in user may read/write ONLY their own prefs docs.
    match /users/{uid}/prefs/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Core business collections — admin only ──
    match /projects/{id}   { allow read, write: if isAdmin(); }
    match /tasks/{id}      { allow read, write: if isAdmin(); }
    match /bartenders/{id} { allow read, write: if isAdmin(); }
    match /payments/{id}   { allow read, write: if isAdmin(); }
    match /events/{id}     { allow read, write: if isAdmin(); }
    match /expenses/{id}   { allow read, write: if isAdmin(); }
    match /inventory/{id}  { allow read, write: if isAdmin(); }

    // ── Push notification device tokens — registered by /admin/js/push.js.
    //    Doc ID is the FCM token itself; any provisioned admin may register
    //    or refresh a token for their own uid. Pruning of dead tokens is done
    //    by the sendPushNotification Cloud Function (admin SDK, bypasses rules).
    match /push_tokens/{token} {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.resource.data.uid == request.auth.uid;
    }

    // ── notifications — creating a doc here triggers an FCM push to all
    //    registered devices. Admin-only from the client; agents/functions
    //    write via the admin SDK.
    match /notifications/{id} { allow read, write: if isAdmin(); }

    // ── Activity log — admin write + read ──
    match /activity/{id}   { allow read, write: if isAdmin(); }

    // ── Closer-mode supporting collections ──
    // call_bookings: created by Cloud Function (admin SDK bypasses rules); admins read/write.
    match /call_bookings/{id}    { allow read, write: if isAdmin(); }
    // kendell_followups: manual Chase-invoice tasks; created by Cloud Function; admin only.
    match /kendell_followups/{id} { allow read, write: if isAdmin(); }
    // nurture_queue / nurture_reports: dry-run send previews + weekly reports,
    //   written by the nurture Cloud Functions (admin SDK); admin read/write.
    match /nurture_queue/{id}   { allow read, write: if isAdmin(); }
    match /nurture_reports/{id} { allow read, write: if isAdmin(); }

    // ── Analytics: anonymous page_view / wizard_step events. Public CREATE
    //    only (never read/update/delete from the client). Admins can read.
    match /page_events/{id} {
      allow create: if true;
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── Expos: per-expo notes, learnings, prep checklists. Admin-only.
    match /expos/{id} {
      allow read, write: if isAdmin();
    }

    // ── Quote builder ──
    // settings/{id} — admin config docs (quote_defaults, etc.). Admin-only.
    match /settings/{id} { allow read, write: if isAdmin(); }

    // quotes/{id} — admins do anything. Clients who hold the quote URL get
    // a single-doc GET (so the public proposal page works), but NOT list/
    // query access — preventing anyone from enumerating every quote in the
    // database via `db.collection('quotes').get()`. Their UPDATE is tightly
    // scoped to the acceptance fields and only allowed when the quote
    // isn't already accepted. They can't touch line items, totals, or any
    // other quote.
    match /quotes/{id} {
      allow get:    if true;                                   // single doc by ID — public
      allow list:   if isAdmin();                              // no enumeration
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (
          /* A draft/locked quote cannot be accepted through a guessed or
             prematurely shared URL. Admin must explicitly mark it sent. */
          resource.data.status == 'sent' &&
          /* Only when no one has accepted yet */
          resource.data.clientAcceptedAt == null &&
          /* The update may ONLY touch these fields */
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clientAcceptedAt','clientAcceptedSignature','clientViewedAt','status']) &&
          /* If status is set, it must be the literal 'accepted' string */
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            request.resource.data.status == 'accepted'
          )
        );
    }
  }
}
